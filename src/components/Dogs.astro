---
import { Image } from "astro:assets";
import ball from "@/assets/sketches/kira-ball.jpg";
import { dogs } from "@/data/dogs";
import { getLocale, useTranslations } from "@/i18n/ui";
import FloatingCircle from "./ornaments/FloatingCircle.astro";
import FrameLines from "./ornaments/FrameLines.astro";
import SectionLabel from "./ornaments/SectionLabel.astro";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  id="dogs"
  class="relative overflow-hidden bg-paper px-8 py-24 sm:px-14 lg:px-20 lg:py-32"
  aria-labelledby="dogs-heading"
  data-dogs
>
  <FrameLines bottom={false} />
  <FloatingCircle variant="nebula" class="top-[8%] right-[18%] size-3 sm:size-4" depth={1.8} />

  <SectionLabel index="03" label={t("dogs.label")} meta={`${dogs.length} ${t("dogs.count")}`} />

  <div class="mt-8 grid gap-6 lg:grid-cols-12">
    <h2
      id="dogs-heading"
      class="font-display text-[clamp(2.25rem,5vw,4.25rem)] leading-[0.95] text-balance lg:col-span-7"
      data-reveal
    >
      {t("dogs.title")}
    </h2>
    <p class="max-w-sm text-graphite lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>
      {t("dogs.intro")}
    </p>
  </div>

  <div class="mt-16 flex flex-col lg:mt-24">
    {
      dogs.map((dog, i) => {
        const flipped = i % 2 === 1;
        const landscape = dog.image ? dog.image.width > dog.image.height : true;
        return (
          <>
            {i > 0 && (
              <div class="relative mt-10 mb-20 h-40 lg:mt-12 lg:mb-28 lg:h-56" aria-hidden="true" data-ball-stage>
                <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" fill="none">
                  <path
                    class="stroke-graphite/40"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-dasharray="1 7"
                    data-ball-trail
                  />
                </svg>
                <span
                  class="absolute bottom-0 left-0 h-2.5 w-16 translate-y-1/2 rounded-full bg-graphite/30 blur-[3px] lg:w-24"
                  data-ball-shadow
                />
                <div class="sketch-blend absolute bottom-0 left-0 size-16 lg:size-24" data-ball>
                  <Image
                    src={ball}
                    alt=""
                    widths={[192, 288]}
                    sizes="96px"
                    class="ball-img size-full"
                    data-ball-spin
                  />
                </div>
                <span class="label-mono absolute top-full left-1/2 mt-5 -translate-x-1/2 whitespace-nowrap text-graphite/50">
                  {t("dogs.ball")}
                </span>
              </div>
            )}

            <article
              class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8"
              aria-labelledby={`dog-${dog.name.toLowerCase()}`}
            >
              {/* The sketch — no frame, blended into the paper */}
              <div
                class:list={[
                  "relative mx-auto w-full lg:col-span-6",
                  landscape ? "max-w-160" : "max-w-125",
                  flipped ? "lg:order-2 lg:col-start-7" : "lg:col-start-1",
                ]}
              >
                {dog.image ? (
                  <Image
                    src={dog.image}
                    alt={dog.name}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 42vw, 90vw"
                    class="dog-sketch sketch-blend h-auto w-full"
                    data-sketch-reveal
                  />
                ) : (
                  <div class="relative aspect-5/4">
                    <svg class="absolute inset-0 size-full text-graphite" viewBox="0 0 400 320" fill="none" aria-hidden="true">
                      <path
                        d="M60 70C120 20 290 18 345 62c47 38 43 168-5 206-60 42-220 38-278-6C18 228 14 110 60 70Z"
                        stroke="currentColor"
                        stroke-opacity="0.55"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        pathLength="1"
                        data-draw
                      />
                      <path
                        d="M74 58c66-32 206-28 264 12 42 40 42 150-6 192-62 38-202 36-260-6C30 222 28 120 80 70"
                        stroke="currentColor"
                        stroke-opacity="0.3"
                        stroke-width="0.9"
                        stroke-linecap="round"
                        pathLength="1"
                        data-draw
                      />
                    </svg>

                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-graphite/60">
                      <svg
                        class="w-16 sm:w-20"
                        viewBox="0 0 120 100"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <ellipse cx="60" cy="68" rx="20" ry="17" />
                        <ellipse cx="30" cy="42" rx="8" ry="11" transform="rotate(-18 30 42)" />
                        <ellipse cx="48" cy="26" rx="8" ry="11" transform="rotate(-6 48 26)" />
                        <ellipse cx="72" cy="26" rx="8" ry="11" transform="rotate(6 72 26)" />
                        <ellipse cx="90" cy="42" rx="8" ry="11" transform="rotate(18 90 42)" />
                      </svg>
                      <span class="label-mono">{t("dogs.pending")}</span>
                    </div>
                  </div>
                )}

                {/* Handwritten margin note */}
                <p
                  class:list={[
                    "pointer-events-none absolute -top-4 font-display text-xl text-graphite sm:text-2xl",
                    flipped ? "-left-2 -rotate-6 sm:-left-6" : "-right-2 rotate-6 sm:-right-6",
                  ]}
                  aria-hidden="true"
                  data-reveal
                >
                  {dog.note[lang] === "zzz…" ? (
                    <span class="zzz inline-flex items-end gap-0.5">
                      <span>z</span>
                      <span>z</span>
                      <span>z</span>
                    </span>
                  ) : (
                    dog.note[lang]
                  )}
                </p>
              </div>

              {/* The notes */}
              <div
                class:list={[
                  "lg:col-span-5",
                  flipped ? "lg:order-1 lg:col-start-1" : "lg:col-start-8",
                ]}
              >
                <p class="label-mono text-graphite/60" data-reveal>
                  N° 0{i + 1} — {dog.role[lang]}
                </p>
                <h3
                  id={`dog-${dog.name.toLowerCase()}`}
                  class="mt-3 font-display text-[clamp(3.5rem,8vw,6.5rem)] leading-none"
                  data-reveal
                >
                  {dog.name}
                </h3>

                <dl class="mt-8 flex flex-col gap-3" data-reveal-stagger>
                  {[
                    [t("dogs.born"), dog.born[lang]],
                    [t("dogs.adopted"), dog.adopted[lang]],
                    [t("dogs.favorite"), dog.favorite[lang]],
                  ].map(([label, value]) => (
                    <div class="flex items-baseline gap-3">
                      <dt class="label-mono shrink-0 text-graphite/60">{label}</dt>
                      <span class="min-w-6 flex-1 border-b border-dotted border-graphite/30" aria-hidden="true" />
                      <dd class="text-right text-ink">{value}</dd>
                    </div>
                  ))}
                </dl>

                <ol
                  class="mt-10 flex flex-col gap-4 text-base leading-relaxed text-graphite sm:text-lg"
                  data-reveal-stagger
                >
                  {dog.quirks.map((quirk, q) => (
                    <li class="flex gap-4">
                      <span class="label-mono pt-[0.45em] text-graphite/50">0{q + 1}</span>
                      <span>{quirk[lang]}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          </>
        );
      })
    }
  </div>
</section>

<style>
  /* A soft diagonal edge sweeps across the drawing, like it's being sketched in.
     GSAP animates --reveal; without JS it stays fully visible. */
  .dog-sketch {
    --reveal: 130%;
    mask-image: linear-gradient(
      115deg,
      #000 calc(var(--reveal) - 30%),
      transparent var(--reveal)
    );
  }

  /* Trim the paper corners so only the round ball spins */
  .ball-img {
    mask-image: radial-gradient(closest-side, #000 94%, transparent 100%);
  }

  .zzz span {
    display: inline-block;
    animation: snooze 2.6s ease-in-out infinite;
  }

  .zzz span:nth-child(2) {
    animation-delay: 0.35s;
    font-size: 0.85em;
  }

  .zzz span:nth-child(3) {
    animation-delay: 0.7s;
    font-size: 0.7em;
  }

  @keyframes snooze {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-6px);
    }
  }
</style>
