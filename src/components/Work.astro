---
import { getImage } from "astro:assets";
import { AUTHOR } from "@/consts";
import { projects } from "@/data/projects";
import { getLocale, useTranslations } from "@/i18n/ui";
import FrameLines from "./ornaments/FrameLines.astro";
import SectionLabel from "./ornaments/SectionLabel.astro";

const t = useTranslations(getLocale(Astro.currentLocale));

const rows = await Promise.all(
  projects.map(async (project, i) => {
    const preview = await getImage({ src: project.image, width: 720, format: "webp" });
    return { ...project, index: String(i + 1).padStart(2, "0"), preview: preview.src };
  }),
);

const rowClass =
  "group relative grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-3 border-b border-graphite/15 py-6 sm:grid-cols-[3.5rem_1fr_14rem_4rem_2rem] sm:py-8";
---

<section
  id="work"
  class="relative bg-paper px-8 py-24 sm:px-14 lg:px-20 lg:py-32"
  aria-labelledby="work-heading"
  data-work
>
  <FrameLines bottom={false} />

  <SectionLabel index="02" label={t("work.label")} meta={`${projects.length} entries`} />

  <div class="mt-8 grid gap-6 lg:grid-cols-12">
    <h2
      id="work-heading"
      class="font-display text-[clamp(2.25rem,5vw,4.25rem)] leading-[0.95] text-balance lg:col-span-7"
      data-reveal
    >
      {t("work.title")}
    </h2>
    <p class="max-w-sm text-graphite lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>
      {t("work.intro")}
    </p>
  </div>

  <ul class="mt-14 border-t border-graphite/15" role="list" data-reveal-stagger>
    {
      rows.map((row) => {
        const Tag = row.url ? "a" : "div";
        return (
          <li>
            <Tag
              class={rowClass}
              data-work-row
              data-preview={row.preview}
              {...(row.url ? { href: row.url, target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="label-mono text-graphite/50">{row.index}</span>
              <span class="font-display text-[clamp(1.75rem,4vw,3rem)] leading-none transition-transform duration-500 ease-out group-hover:translate-x-3">
                {row.name}
              </span>
              <span class="label-mono col-start-2 text-graphite/70 sm:col-start-auto">{row.tags}</span>
              <span class="label-mono hidden text-graphite/50 sm:block">{row.year ?? "—"}</span>
              <span
                class="col-start-3 row-start-1 text-right text-xl text-graphite transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:col-start-auto sm:row-start-auto"
                aria-hidden="true"
              >
                {row.url ? "↗" : ""}
              </span>
              <img
                src={row.preview}
                alt=""
                class="col-span-full mt-2 aspect-video w-full border border-graphite/15 object-cover object-top grayscale contrast-125 sm:hidden"
                loading="lazy"
                width="720"
                height="405"
              />
              <span class="absolute inset-x-0 bottom-[-1px] h-px origin-left scale-x-0 bg-ink transition-transform duration-500 ease-out group-hover:scale-x-100" />
            </Tag>
          </li>
        );
      })
    }
    <li>
      <a
        href={AUTHOR.github}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[rowClass, "text-graphite/70 hover:text-ink"]}
      >
        <span class="label-mono text-graphite/50">++</span>
        <span class="label-mono">{t("work.more")}</span>
        <span class="hidden sm:block"></span>
        <span class="hidden sm:block"></span>
        <span class="col-start-3 row-start-1 text-right text-xl sm:col-start-auto sm:row-start-auto" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>

  <!-- Cursor-following preview (desktop only) -->
  <div
    class="pointer-events-none fixed top-0 left-0 z-40 hidden w-[min(28vw,380px)] opacity-0 lg:block"
    data-work-preview
    aria-hidden="true"
  >
    <div class="relative -translate-x-1/2 -translate-y-1/2 -rotate-2 bg-stardust p-2 shadow-[0_12px_40px_-12px_rgb(0_0_0/0.35)]">
      <img
        class="block aspect-[4/3] w-full object-cover object-top grayscale contrast-125"
        alt=""
        data-work-preview-img
      />
      <svg class="absolute -inset-1.5 h-[calc(100%+0.75rem)] w-[calc(100%+0.75rem)] overflow-visible" fill="none" preserveAspectRatio="none" viewBox="0 0 100 100">
        <rect
          x="0"
          y="0"
          width="100"
          height="100"
          stroke="currentColor"
          stroke-width="0.35"
          pathLength="1"
          class="text-graphite"
          data-work-preview-stroke></rect>
      </svg>
    </div>
  </div>
</section>
