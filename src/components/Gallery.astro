---
import langflowImg from "@/assets/img/langflow.png";
import datastaxImg from "@/assets/img/datastax.png";
import tinaImg from "@/assets/img/tina.png";
import luxylistImg from "@/assets/img/luxylist.png";
import dashfiImg from "@/assets/img/dashfi.png";

const projects = [
  {
    id: "luxylist",
    label: "Luxylist",
    src: luxylistImg.src,
    w: "w-36 sm:w-44 lg:w-52",
    aspect: "aspect-[4/3]",
    x: "left-[8%] top-[12%]",
    delay: "0s",
  },
  {
    id: "datastax",
    label: "Datastax",
    src: datastaxImg.src,
    w: "w-32 sm:w-40 lg:w-48",
    aspect: "aspect-[3/4]",
    x: "right-[6%] top-[18%] z-1",
    delay: "0.8s",
  },
  {
    id: "tina",
    label: "Tina Rosero",
    src: tinaImg.src,
    w: "w-28 sm:w-36 lg:w-40",
    aspect: "aspect-square",
    x: "left-[42%] top-[4%]",
    delay: "0.4s",
  },
  {
    id: "dashfi",
    label: "Dash-Fi",
    src: dashfiImg.src,
    w: "w-36 sm:w-44 lg:w-56",
    aspect: "aspect-video",
    x: "left-[18%] bottom-[8%]",
    delay: "1.2s",
  },
  {
    id: "langflow",
    label: "DataStax",
    src: langflowImg.src,
    w: "w-28 sm:w-32 lg:w-40",
    aspect: "aspect-[5/4]",
    x: "right-[18%] bottom-[14%] z-2",
    delay: "1.6s",
  },
];
---

<section
  class="relative z-10 min-h-[320px] sm:min-h-[420px] lg:col-span-7 lg:min-h-[520px] xl:col-span-8"
  aria-labelledby="gallery-heading"
>
  <h2 id="gallery-heading" class="sr-only">Project gallery</h2>
  <ul class="relative h-full min-h-[inherit] list-none" role="list">
    {
      projects.map((project) => (
        <li class:list={["absolute", project.x, project.w]}>
          <figure
            class:list={[
              project.aspect,
              "relative w-full overflow-hidden border border-border bg-muted",
            ]}
          >
            {project.src ? (
              <img
                src={project.src}
                alt={project.label}
                class="absolute inset-0 h-full w-full object-cover object-top-left grayscale-100 contrast-115"
                width="400"
                height="300"
                loading="lazy"
              />
            ) : (
              <div class="project-placeholder" aria-hidden="true" />
            )}
            <figcaption class="absolute inset-x-0 bottom-0 z-10 bg-background/70 px-2 py-1.5 font-mono text-[10px] tracking-wider text-muted-foreground uppercase backdrop-blur-[2px] sm:text-xs">
              {project.label}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
