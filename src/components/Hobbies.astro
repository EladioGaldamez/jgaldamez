---
import { Image } from "astro:assets";
import { AUTHOR } from "@/consts";
import { getLocale, useTranslations } from "@/i18n/ui";
import joystick from "@/assets/sketches/sketch-joystick.jpg";
import Crosshair from "./ornaments/Crosshair.astro";
import FloatingCircle from "./ornaments/FloatingCircle.astro";
import FrameLines from "./ornaments/FrameLines.astro";
import SectionLabel from "./ornaments/SectionLabel.astro";

const t = useTranslations(getLocale(Astro.currentLocale));
---

<section
  id="hobbies"
  class="relative overflow-hidden bg-paper px-8 py-24 sm:px-14 lg:px-20 lg:py-32"
  aria-labelledby="hobbies-heading"
>
  <FrameLines bottom={false} />
  <FloatingCircle class="-bottom-[10vw] -left-[8vw] size-[30vw] min-w-[220px] min-h-[220px]" depth={0.5} />
  <Crosshair class="top-[22%] right-[12%] hidden sm:block" />

  <SectionLabel index="03" label={t("hobbies.label")} meta="P1 · Press start" />

  <div class="mt-8 grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <h2
        id="hobbies-heading"
        class="font-display text-[clamp(2.25rem,5vw,4.25rem)] leading-[0.95] text-balance"
        data-reveal
      >
        {t("hobbies.title")}
      </h2>

      <div class="mt-8 flex max-w-[44ch] flex-col gap-5 text-base leading-relaxed text-graphite sm:text-lg" data-reveal-stagger>
        <p>{t("hobbies.p1")}</p>
        <p>{t("hobbies.p2")}</p>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-6" data-reveal-stagger>
        <span class="label-mono inline-flex items-center gap-2.5 border border-graphite/20 px-3 py-2 text-graphite/80">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-ash opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-ash"></span>
          </span>
          {t("hobbies.status")}
        </span>
        <a
          href={AUTHOR.twitch}
          target="_blank"
          rel="noopener noreferrer"
          class="label-mono group inline-flex min-h-11 items-center gap-2 bg-ink px-5 py-3 text-stardust transition-colors duration-300 hover:bg-matter focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
        >
          {t("hobbies.cta")}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-7" data-joystick>
      <div class="sketch-blend relative mx-auto aspect-[1365/768] w-full max-w-[720px]" data-joystick-float>
        <Image
          src={joystick}
          alt=""
          widths={[480, 768]}
          sizes="(min-width: 1024px) 32vw, 60vw"
          class="absolute top-1/2 left-1/2 h-auto w-[56.26%] max-w-none -translate-x-1/2 -translate-y-1/2 rotate-90"
        />
      </div>
    </div>
  </div>
</section>
