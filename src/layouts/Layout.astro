---
import "@/styles/global.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { AUTHOR, LOCALES, SITE } from "@/consts";
import { getLocale, useTranslations } from "@/i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title,
  description = t("meta.description"),
  image = SITE.ogImage,
  type = "website",
  noindex = false,
} = Astro.props;

const { lang, og: ogLocale } = LOCALES[locale];
const alternates = (Object.keys(LOCALES) as (keyof typeof LOCALES)[]).map(
  (code) => ({ code, href: getAbsoluteLocaleUrl(code, "") }),
);

const pageTitle = title
  ? SITE.titleTemplate.replace("%s", title)
  : t("meta.title");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const imageUrl = new URL(image, Astro.site ?? SITE.url);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      alternateName: "Jose Galdamez",
      url: SITE.url,
      image: imageUrl.href,
      jobTitle: SITE.jobTitle,
      description: SITE.description,
      knowsAbout: AUTHOR.skills,
      address: {
        "@type": "PostalAddress",
        addressLocality: AUTHOR.location.city,
        addressCountry: AUTHOR.location.countryCode,
      },
      sameAs: AUTHOR.socials,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: lang,
      publisher: { "@id": `${SITE.url}/#person` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${SITE.url}/#website` },
      about: { "@id": `${SITE.url}/#person` },
      primaryImageOfPage: imageUrl.href,
      inLanguage: lang,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.code} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={SITE.ogImageWidth} />
    <meta property="og:image:height" content={SITE.ogImageHeight} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=DM+Mono:wght@400;500&family=Fredericka+the+Great&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="relative">
    <slot />
    <div class="paper-grain" aria-hidden="true"></div>
  </body>
</html>
