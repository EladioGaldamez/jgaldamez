---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "José Galdámez" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="José Galdámez — Frontend Engineer based in Guatemala. React, Next.js, Node, and PostgreSQL."
    />
    <link rel="icon" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="relative bg-background text-foreground">
    <slot />
  </body>
</html>
